# Base URL of the FastAPI backend.
# Leave as /api during development: vite.config.js proxies /api -> the backend,
# so the browser makes same-origin requests and CORS never applies.
# For a deployed frontend set the full origin of your backend, e.g.
#   VITE_API_BASE_URL=https://sarcasm-api.onrender.com
VITE_API_BASE_URL=/api

# Only used by `npm run dev`: where the /api proxy forwards to.
VITE_DEV_PROXY_TARGET=http://localhost:8000
