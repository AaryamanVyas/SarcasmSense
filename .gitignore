# =============================================================================
# Research artefacts. These are large, machine-generated and reproducible from
# the scripts, so they must not enter git history.
# =============================================================================

# --- datasets (see scripts/download_datasets.py) ------------------------------
data/raw/**
!data/raw/.gitkeep
data/processed/**
!data/processed/.gitkeep
data/splits/**
!data/splits/.gitkeep
!data/sample/**

# --- knowledge base & FAISS index --------------------------------------------
knowledge/raw/**
!knowledge/raw/.gitkeep
knowledge/processed/**
!knowledge/processed/.gitkeep
knowledge/index/**
!knowledge/index/.gitkeep
knowledge/index_sample/**
!knowledge/index_sample/.gitkeep

# --- model checkpoints --------------------------------------------------------
checkpoints/**
!checkpoints/.gitkeep

# --- results ------------------------------------------------------------------
results/**
!results/.gitkeep
!results/figures/.gitkeep

# --- large binaries anywhere --------------------------------------------------
*.bin
*.safetensors
*.pt
*.pth
*.ckpt
*.faiss
*.npy
*.npz
*.csv.gz
*.bz2
*.zip
*.tar.gz

# --- caches -------------------------------------------------------------------
.cache/
nltk_data/
*.log

# --- OS / editors -------------------------------------------------------------
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*~

# --- notebooks ----------------------------------------------------------------
.ipynb_checkpoints/

