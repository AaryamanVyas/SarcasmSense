# =============================================================================
# Environment configuration -- copy to .env and edit. NEVER commit .env.
# Every value below has a safe default in backend/settings.py; nothing in the
# serving code hard-codes a host, port, path or origin.
# =============================================================================

# --- model -------------------------------------------------------------------
# Directory produced by scripts/train.py. Point this at the checkpoint you want
# to serve. It must contain pytorch_model.bin, model_config.json, the tokenizer
# files and training_config.yaml.
MODEL_PATH=checkpoints/full_model/best_model

# Torch device. Leave empty to auto-detect CUDA and fall back to CPU.
# DEVICE=cpu

# Override the training_config.yaml bundled with the checkpoint (rarely needed).
# CONFIG_PATH=configs/full_model.yaml

# Set false to start the API without loading the model (tests / debugging only).
LOAD_MODEL_ON_STARTUP=true

# --- API ---------------------------------------------------------------------
# Comma-separated list of browser origins allowed to call the API.
# In production list your real frontend origin. Avoid "*".
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173

# Path prefix when running behind a reverse proxy that strips it, e.g. /sarcasm
ROOT_PATH=

# MUST stay false in production: true returns internal error details to clients.
DEBUG=false

# --- request limits ----------------------------------------------------------
MAX_TEXT_LENGTH=2000
MAX_CONTEXT_TURNS=3
MAX_CONTEXT_TURN_LENGTH=2000
MAX_BATCH_SIZE=16

# --- logging -----------------------------------------------------------------
LOG_LEVEL=INFO
# "json" for production (one JSON object per line), "console" for local dev.
LOG_FORMAT=json
# Off by default: user-submitted text is not written to logs.
LOG_REQUEST_TEXT=false

# --- dashboard ---------------------------------------------------------------
RESULTS_DIR=results

# --- single-container deployment ---------------------------------------------
# Serve the pre-built React bundle from the API process. Use this on platforms
# that only allow one service (Render free tier, Hugging Face Spaces).
# With docker-compose the frontend has its own nginx container instead.
SERVE_FRONTEND=false
FRONTEND_DIST=frontend_dist

# --- docker compose ----------------------------------------------------------
BACKEND_PORT=8000
FRONTEND_PORT=5173
BACKEND_MEMORY_LIMIT=6g

# --- offline / caches --------------------------------------------------------
# Where HuggingFace caches downloaded weights.
# HF_HOME=~/.cache/huggingface
# Where NLTK looks for WordNet / SentiWordNet.
NLTK_DATA=knowledge/raw/nltk_data
# Set to 1 to forbid any hub access at runtime (fully offline serving).
# HF_HUB_OFFLINE=0
